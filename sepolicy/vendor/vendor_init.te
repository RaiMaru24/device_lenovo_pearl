set_prop(vendor_init, vendor_power_prop)
set_prop(vendor_init, vendor_alarm_boot_prop)
set_prop(vendor_init, vendor_video_prop)
get_prop(vendor_init, vendor_tee_listener_prop);
allow vendor_init persist_debug_prop:file { read };
dontaudit vendor_init default_prop:property_service set;


allow vendor_init {
  vendor_debugfs_clk
  proc_dirty
  proc_sched_energy_aware
}:file w_file_perms;